<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>WinPopCast.Spout</RootNamespace>
    <SpoutBridgeDll>$(MSBuildThisFileDirectory)..\..\native\SpoutBridge\build\Release\WinPopCastSpoutBridge.dll</SpoutBridgeDll>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinPopCast.Core\WinPopCast.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- native/SpoutBridge を CMake でビルドしたもの（README 参照） -->
    <None Include="$(SpoutBridgeDll)" Link="WinPopCastSpoutBridge.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(SpoutBridgeDll)')" />
  </ItemGroup>
  <Target Name="WarnMissingSpoutBridge" BeforeTargets="Build" Condition="!Exists('$(SpoutBridgeDll)')">
    <Warning Text="WinPopCastSpoutBridge.dll が見つかりません。native/SpoutBridge を CMake でビルドしてください。" />
  </Target>
</Project>
