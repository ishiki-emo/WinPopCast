<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>AppCapture.Spout</RootNamespace>
    <SpoutBridgeDll>$(MSBuildThisFileDirectory)..\..\native\SpoutBridge\build\Release\AppCaptureSpoutBridge.dll</SpoutBridgeDll>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AppCapture.Core\AppCapture.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- native/SpoutBridge を CMake でビルドしたもの（README 参照） -->
    <None Include="$(SpoutBridgeDll)" Link="AppCaptureSpoutBridge.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(SpoutBridgeDll)')" />
  </ItemGroup>
  <Target Name="WarnMissingSpoutBridge" BeforeTargets="Build" Condition="!Exists('$(SpoutBridgeDll)')">
    <Warning Text="AppCaptureSpoutBridge.dll が見つかりません。native/SpoutBridge を CMake でビルドしてください。" />
  </Target>
</Project>
