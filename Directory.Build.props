<Project>
  <PropertyGroup>
    <!-- WGC の IsBorderRequired 等を使うため 22621 SDK の投影を参照。実行要件は 2004 (19041) 以降（IsCursorCaptureEnabled のため） -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <Version>0.1.1</Version>
    <Product>WinPopCast</Product>
    <Authors>ishiki-emo</Authors>
    <Copyright>Copyright (c) 2026 ishiki-emo</Copyright>
    <Description>指定したアプリのウィンドウだけを合成して Spout2 で送るキャプチャツール</Description>
  </PropertyGroup>
</Project>
